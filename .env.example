# =====================================================================
# Aangan voice agent: settings and secrets
# Copy to .env.local and fill in. Never commit or share .env.local.
# A blank value (KEY=) means "not set".
# =====================================================================

# ---------------------------------------------------------------------
# PART A: FILL NOW (Checkpoint 1: database and dashboard login)
# ---------------------------------------------------------------------

# Where all calls, bookings and audit logs are stored.
# Neon dashboard -> your project -> Connect -> copy the "Pooled connection" string.
DATABASE_URL=

# Random key that signs the dashboard login cookie. Already generated; don't change it.
SESSION_SECRET=

# Address of the dashboard. Keep this for local; change to the Vercel URL after deploying.
# Used to build "Open in dashboard" links in emails and calendar events.
APP_URL=http://localhost:3000

# The three dashboard logins, created by `npm run db:seed`.
# Each email must be different. Gmail trick: you+nikhil@gmail.com, you+ruhi@gmail.com
# and you+jay@gmail.com all arrive in your own inbox.
# The designer emails are also where each designer's lead emails go.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_RUHI_EMAIL=
SEED_RUHI_PASSWORD=
SEED_JAY_EMAIL=
SEED_JAY_PASSWORD=

# ---------------------------------------------------------------------
# PART B: MOCK SWITCHES (leave as true until that service is connected)
# true = fake version, nothing real is called. Flip to false one by one at each checkpoint.
# ---------------------------------------------------------------------
MOCK_VOICE=true
MOCK_CALENDAR=true
MOCK_AI=true
MOCK_EMAIL=true
MOCK_CRM=true

# ---------------------------------------------------------------------
# PART C: FILL LATER (you'll be asked at each checkpoint)
# ---------------------------------------------------------------------

# --- Vaani (Checkpoint 6) ---
# Your Vaani API key (vv_live_...). Used to talk to Vaani's API.
VAANI_API_KEY=
# Shown ONCE when we register our webhook in Vaani (vv_whk_...). Proves post-call data really came from Vaani.
VAANI_WEBHOOK_SECRET=
# Password Vaani sends with every mid-call tool request (lookup_caller, check_fit, ...). Already generated.
# You paste the same value into each Vaani custom tool's header: x-aangan-tool-secret.
TOOL_SHARED_SECRET=

# --- Google Calendar (Checkpoint 5): ONE shared studio calendar ---
# Both designers share one calendar. A booked time blocks that slot for everyone;
# the designer is picked at random from those still free that day.
# The robot account's key (base64 of its JSON file). I'll guide you step by step.
GOOGLE_SERVICE_ACCOUNT_B64=
# The calendar's ID: Google Calendar -> calendar settings -> "Integrate calendar" -> Calendar ID.
GOOGLE_CALENDAR_ID=

# --- Gemini (Checkpoint 3, only when switching MOCK_AI to false) ---
# Reads each finished call's transcript and writes the summary and designer brief. It never decides fit.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Email via Resend (Checkpoint 7) ---
RESEND_API_KEY=
# The "from" address. Resend's test sender works without owning a domain.
EMAIL_FROM=Aangan Assistant <onboarding@resend.dev>
# Safety switch: while true, EVERY email goes to EMAIL_TEST_TO instead of the real person,
# with the intended recipient shown in the subject. Keep true for the whole project.
EMAIL_TEST_MODE=true
# Your own email. With test mode on, this is the only inbox that ever receives anything.
EMAIL_TEST_TO=
# Who gets the daily 8 am summary and the urgent "agent said a price" alert. In the story this is Nikhil.
# For this project, use your own email (or leave blank: test mode sends to EMAIL_TEST_TO anyway).
OWNER_EMAIL=
# Who is alerted at once when an EXISTING client calls angry, e.g. "my designer hasn't replied in
# five days" (case T09). Optional: if blank, it goes to OWNER_EMAIL.
ESCALATION_EMAIL=

# --- HubSpot CRM (Checkpoint 7) ---
# Private-app token from a free HubSpot account. Qualified leads become deals here.
HUBSPOT_TOKEN=

# --- Background jobs ---
# Password for the scheduled jobs (missed-call check every 15 minutes, 8 am digest). Already generated.
CRON_SECRET=
# How many months to keep call recordings and transcripts before automatic deletion.
RETENTION_MONTHS=12
