# Copy to .env.local and fill in. Never commit .env.local.

# --- Core (needed from Checkpoint 1) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require   # Neon pooled connection string
SESSION_SECRET=                                                    # 32+ random characters
APP_URL=http://localhost:3000

# Dashboard users (used only by `npm run db:seed`)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_RUHI_EMAIL=
SEED_RUHI_PASSWORD=
SEED_JAY_EMAIL=
SEED_JAY_PASSWORD=
SEED_RUHI_CALENDAR_ID=
SEED_JAY_CALENDAR_ID=

# --- Mock switches: everything is mocked until its checkpoint ---
MOCK_VOICE=true
MOCK_CALENDAR=true
MOCK_AI=true
MOCK_EMAIL=true
MOCK_CRM=true

# --- Voice: Vaani Labs (Checkpoint 6) ---
VAANI_WEBHOOK_SECRET=        # vv_whk_... shown once when the webhook is registered
VAANI_API_KEY=               # vv_live_...
TOOL_SHARED_SECRET=          # sent by Vaani tool calls in x-aangan-tool-secret

# --- Google Calendar (Checkpoint 5) ---
GOOGLE_SERVICE_ACCOUNT_B64=  # base64 of the service-account JSON key

# --- Gemini (Checkpoint 3, real mode) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Email: Resend (Checkpoint 7) ---
RESEND_API_KEY=
EMAIL_FROM=Aangan Assistant <onboarding@resend.dev>
EMAIL_TEST_MODE=true
EMAIL_TEST_TO=
ESCALATION_EMAIL=
OWNER_EMAIL=

# --- HubSpot (Checkpoint 7) ---
HUBSPOT_TOKEN=

# --- Cron (called by an external scheduler with Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET=
RETENTION_MONTHS=12
